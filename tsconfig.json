{
  // Server and shared code. Node runs these .ts files directly (type
  // stripping), so this config only type-checks: it never emits.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
