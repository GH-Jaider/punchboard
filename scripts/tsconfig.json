{
  // The build and test tools written in TypeScript (scripts/*.ts and the
  // sidecar smoke test). Node runs them directly (type stripping), so this
  // config only type-checks. allowJs lets them import the tests' shared
  // helpers, which are still .mjs; those are read for their types, not checked.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["./*.ts", "../tests/*.ts"]
}
