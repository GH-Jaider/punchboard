{
  "name": "punchboard",
  "version": "1.4.2",
  "private": true,
  "description": "Turn any tablet or phone into a macro pad for your computer, with deep OBS support for streaming.",
  "license": "Apache-2.0",
  "repository": "github:GH-Jaider/punchboard",
  "type": "module",
  "main": "src/server/main.ts",
  "scripts": {
    "start": "node src/server/main.ts",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "build:server": "node scripts/build-server.mjs",
    "tauri": "tauri",
    "app:dev": "npm run build && npm run build:server && tauri dev",
    "app:build": "node scripts/fetch-node.mjs && tauri build",
    "release:mac": "node scripts/release-mac.mjs && node scripts/latest-json.mjs",
    "test": "node tests/security.test.mjs && node tests/actions.test.mjs && node tests/trackpad.test.mjs && node tests/touchpad.test.mjs && node tests/windows.test.mjs",
    "release:windows": "node scripts/release-windows.mjs"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.6",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^2.8.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
